# 复制为 .env.local，只在这台 Windows 电脑填写。不要提交、截图或发送密钥。
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT：Groq 免费额度优先
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=zh
GROQ_API_KEY=

# LLM：DeepSeek（OpenAI-compatible）
REALTIME_LLM_BASE_URL=https://api.deepseek.com
REALTIME_LLM_API_KEY=
REALTIME_LLM_MODEL=deepseek-chat
REALTIME_LLM_TEMPERATURE=0.85

# 两家都填。每通电话按角色 voiceProfile.provider 自动选择。
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.8-hd
# 国内站留空即可；海外站可按实际账户填写 https://api.minimax.io
MINIMAX_BASE_URL=

# 未收到角色选择时的兜底，不影响已指定服务商的角色。
TTS_PROVIDER=elevenlabs
REALTIME_AGENT_DISPATCH_MODE=auto

# 可选调试参数
REALTIME_INIT_WAIT_MS=10000
