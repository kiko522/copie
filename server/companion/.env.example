# 对外 API 的访问令牌。请生成至少 32 字节的随机值，不要提交真实值。
BACKEND_TOKEN=replace-with-a-long-random-token

# 浏览器来源。正式部署填小手机前端的 HTTPS 地址；多个来源用英文逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:5173

PORT=8787
TZ=Asia/Shanghai

# Tavily 密钥只保存在 VPS 上。
TAVILY_API_KEY=

# OpenAI 兼容模型接口。当前默认使用 DeepSeek。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
HEARTBEAT_MODEL=deepseek-chat

# Docker Compose 中 TrendRadar MCP 与后端处于同一内部网络，不向公网开放。
TRENDRADAR_MCP_URL=http://trendradar-mcp:3333/mcp

# itboy 主源使用城市代码。北京为 101010100；可按角色所在地扩充映射。
ITBOY_CITY_CODES={"北京":"101010100","Beijing":"101010100"}

# 请求预算。
UPSTREAM_TIMEOUT_MS=8000

# 心跳与主动联系规则（用户所在时区）。
USER_TIME_ZONE=Asia/Shanghai
QUIET_START=02:00
QUIET_END=08:30
MAX_UNANSWERED_SENDS=3
HEARTBEAT_TICK_MS=60000
DATA_DIR=/data
